#!/bin/bash
# brain-watch — /watch self-channel listener launcher.
#
# Lives in hooks/scripts/ — NOT a top-level bin/: claude.ai-hosted plugins may
# not ship bin/ executables. Invoked by absolute path from ANY repo or session:
# read PLUGIN_ROOT from ~/.config/brain/resolved.env (written by every hook run)
# and run "<PLUGIN_ROOT>/hooks/scripts/brain-watch" as a single plain command —
# see skills/watch/SKILL.md. Routes
# through brain-env.sh — the same python resolution every launcher uses
# (bundled venv, ensure-runtime bootstrap, PYTHONHOME hygiene). The poller
# finds the daemon by port (uid-derived), not by path.
#
# Usage: hooks/scripts/brain-watch [session_id] [fast_s=5] [slow_s=60] [backoff=2.0]
#
# session_id defaults to $CLAUDE_CODE_SESSION_ID — the full session UUID Claude
# Code exports into every command's environment — so `brain-watch` with NO args
# watches THIS session. The boot banner's MY_SESSION_ID scrolls out of context in
# a long session; the env var never does. Pass an explicit id only to watch a
# DIFFERENT session's inbox.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# brain-env.sh (sibling) sets $BRAIN_PYTHON + $PLUGIN_DIR and bootstraps the runtime.
# 1>&2: our stdout is the Monitor event stream — keep bootstrap chatter off it.
source "$SCRIPT_DIR/brain-env.sh" 1>&2
# No arg → watch THIS session, resolved from the env var Claude Code sets per
# command. :? fails loud (rather than a silent empty-inbox poll) when run with
# no id outside a Claude Code session.
if [ "$#" -eq 0 ]; then
  set -- "${CLAUDE_CODE_SESSION_ID:?pass <session_id> or run inside a Claude Code session}"
fi
# Role-named interpreter: `Entity-in-3207` pairs with the same session's
# `Entity-mcp-3207` in Activity Monitor (brain_python_as).
exec "$(brain_python_as Entity-in "$1")" "$PLUGIN_DIR/hooks/scripts/self_inbox_poller.py" "$@"
